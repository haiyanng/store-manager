<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="registerPanel"
           id="registerPanel"
           fx:controller="com.customershopfx.auth.view.RegisterController"
           alignment="CENTER"
           prefWidth="420" maxWidth="420" minHeight="700" prefHeight="760" maxHeight="Infinity"
           styleClass="register-panel">
    <padding>
        <Insets top="24" right="0" bottom="24" left="0"/>
    </padding>
    <children>
        <VBox fx:id="registerContent" alignment="CENTER_LEFT" spacing="18" maxWidth="420"
              styleClass="register-content">
            <children>
                <VBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="CUSTOMER SHOP" styleClass="auth-eyebrow"/>
                    <Label text="Create account" styleClass="auth-title"/>
                    <Label text="One account for browsing, cart, and checkout" styleClass="auth-subtitle" wrapText="true"/>
                </VBox>

                <VBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Full name" styleClass="auth-label"/>
                    <TextField fx:id="nameField" promptText="Full name" styleClass="auth-input"/>
                </VBox>

                <VBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Phone" styleClass="auth-label"/>
                    <TextField fx:id="phoneField" promptText="Phone" styleClass="auth-input"/>
                </VBox>

                <VBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Email" styleClass="auth-label"/>
                    <TextField fx:id="emailField" promptText="Email" styleClass="auth-input"/>
                </VBox>

                <VBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Password" styleClass="auth-label"/>
                    <PasswordField fx:id="passwordField" promptText="Password" styleClass="auth-input"/>
                </VBox>

                <VBox spacing="12" alignment="CENTER_LEFT">
                    <Button fx:id="registerButton" id="registerButton" text="Register" maxWidth="Infinity"
                            onAction="#register" styleClass="button-primary"/>
                    <Button fx:id="backButton" id="backButton" text="Back to login" maxWidth="Infinity"
                            onAction="#backToLogin" styleClass="button-secondary"/>
                </VBox>

                <VBox spacing="6" alignment="CENTER_LEFT">
                    <Label fx:id="messageLabel" styleClass="auth-status"/>
                    <Label text="Use your customer account to access cart, checkout, and order history."
                           styleClass="auth-helper" wrapText="true"/>
                    <Label text="Customer shopping platform" styleClass="auth-helper"/>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
