<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.user.view.UserManagementController"
      spacing="18"
      styleClass="module-screen">

    <VBox spacing="5" styleClass="module-header">
        <Label text="User Management" styleClass="content-title"/>
        <Label text="Manage staff accounts, roles and employee links." styleClass="content-description"/>
    </VBox>

    <HBox spacing="10" styleClass="module-panel, soft-indigo">
        <TextField fx:id="usernameField"
                   promptText="Username"
                   styleClass="module-input"
                   HBox.hgrow="ALWAYS"/>

        <PasswordField fx:id="passwordField"
                       promptText="Password"
                       styleClass="module-input"
                       HBox.hgrow="ALWAYS"/>

        <ComboBox fx:id="roleComboBox"
                  prefWidth="150" promptText="Role" styleClass="module-input"/>

        <ComboBox fx:id="employeeComboBox"
                  prefWidth="220"
                  promptText="Linked employee" styleClass="module-input"/>

        <Button fx:id="clearLinkButton" styleClass="module-secondary-button"
                text="Clear link"
                onAction="#onClearEmployeeLink"/>

    </HBox>

    <HBox spacing="10">
        <Button fx:id="refreshButton" styleClass="module-secondary-button" text="Refresh" onAction="#onRefresh"/>
        <Button fx:id="clearButton" styleClass="module-secondary-button" text="Clear form" onAction="#onClear"/>

        <Button fx:id="createButton" styleClass="primary-button"
                text="Create"
                onAction="#onCreateUser"/>

        <Button fx:id="editButton" styleClass="module-button"
                text="Save changes"
                onAction="#onEditUser"/>

        <Button fx:id="deleteButton" styleClass="danger-button"
                text="Delete"
                onAction="#onDeleteUser"/>
    </HBox>

    <TableView fx:id="usersTable" styleClass="analytics-table"
               VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn"
                         text="ID"
                         prefWidth="80"/>

            <TableColumn fx:id="usernameColumn"
                         text="Username"
                         prefWidth="220"/>

            <TableColumn fx:id="roleColumn"
                         text="Role"
                         prefWidth="180"/>

            <TableColumn fx:id="employeeColumn"
                         text="Employee"
                         prefWidth="220"/>

            <TableColumn fx:id="activeColumn"
                         text="Status"
                         prefWidth="120"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel" text="Ready" visible="false" managed="false" styleClass="content-description"/>

    <padding>
        <Insets top="0"
                right="0"
                bottom="0"
                left="0"/>
    </padding>
</VBox>
