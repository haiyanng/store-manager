<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.sale.view.SaleController"
      spacing="18">

    <VBox spacing="6">
        <Label text="Sale"
               styleClass="content-title"/>

        <Label text="Create in-store orders and track completed sales."
               styleClass="content-description"/>
    </VBox>

    <fx:define>
        <ToggleGroup fx:id="orderViewGroup"/>
    </fx:define>

    <HBox spacing="12">
        <ToggleButton fx:id="orderTabButton" text="Sale" selected="true"
                      toggleGroup="$orderViewGroup"
                      styleClass="module-button, order-tab-button"
                      onAction="#onShowOrder"/>
        <ToggleButton fx:id="detailsTabButton" text="Order details"
                      toggleGroup="$orderViewGroup"
                      styleClass="module-button, order-tab-button"
                      onAction="#onShowOrderDetails"/>
    </HBox>

    <VBox spacing="18" visible="${orderTabButton.selected}" managed="${orderTabButton.selected}">

        <VBox spacing="14">
            <fx:include fx:id="productSelectionWorkflow"
                        source="../shared/product-selection-workflow.fxml"/>

            <VBox spacing="12"
                  styleClass="analytics-card">
                <Label text="Selected product"
                       styleClass="analytics-card-title"/>

                <HBox spacing="16">
                    <StackPane prefWidth="160"
                               prefHeight="160"
                               minWidth="160"
                               minHeight="160"
                               maxWidth="160"
                               alignment="CENTER"
                               maxHeight="160"
                               style="-fx-background-color: rgba(255, 255, 255, 0.72);
                                      -fx-background-radius: 12;
                                      -fx-border-color: rgba(0, 0, 0, 0.08);
                                      -fx-border-radius: 12;">
                        <ImageView fx:id="selectedProductImageView"
                                   fitWidth="140"
                                   fitHeight="140"
                                   preserveRatio="true"
                                   smooth="true"
                                   pickOnBounds="true"/>

                        <Label fx:id="selectedProductImagePlaceholderLabel"
                               text="No image"
                               visible="false"
                               managed="false"
                               styleClass="analytics-card-detail"/>
                    </StackPane>

                    <VBox spacing="4"
                          HBox.hgrow="ALWAYS">
                        <Label fx:id="selectedProductPreviewMessageLabel"
                               text="Select a product to preview"
                               styleClass="content-description"/>

                        <Label fx:id="selectedProductPreviewNameLabel"
                               text="Name: -"
                               styleClass="content-title"/>

                        <Label fx:id="selectedProductPreviewSkuLabel"
                               text="SKU: -"
                               styleClass="analytics-card-detail"/>

                        <Label fx:id="selectedProductPreviewPriceLabel"
                               text="Unit price: 0.00"
                               styleClass="analytics-card-detail"/>

                        <Label fx:id="selectedProductPreviewStockLabel"
                               text="Stock: N/A"
                               styleClass="analytics-card-detail"/>
                    </VBox>
                </HBox>
            </VBox>

            <HBox fx:id="cartActions" spacing="12">
                <TextField fx:id="quantityField"
                           promptText="Qty"
                           prefWidth="90"
                           styleClass="module-input"/>

                <Button text="Add item"
                        styleClass="module-button"
                        onAction="#onAddToCart"/>

                <Button text="Remove item"
                        styleClass="module-button"
                        onAction="#onRemoveItem"/>

                <Button text="Update quantity"
                        styleClass="module-button"
                        onAction="#onUpdateQuantity"/>

                <Button text="Clear items"
                        styleClass="module-button"
                        onAction="#onClearCart"/>
            </HBox>
        </VBox>

        <VBox spacing="8">
            <Label text="Cart"
                   styleClass="content-description"/>

            <TableView fx:id="cartTable"
                       prefHeight="250">
                <columns>
                    <TableColumn fx:id="cartProductColumn"
                                 text="Product"
                                 prefWidth="240"/>

                    <TableColumn fx:id="cartSkuColumn"
                                 text="SKU"
                                 prefWidth="130"/>

                    <TableColumn fx:id="cartQuantityColumn"
                                 text="Quantity"
                                 prefWidth="80"/>

                    <TableColumn fx:id="cartUnitPriceColumn"
                                 text="Unit price"
                                 prefWidth="120"/>

                    <TableColumn fx:id="cartSubtotalColumn"
                                 text="Subtotal"
                                 prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Amount received" styleClass="content-description"/>
            <TextField fx:id="amountReceivedField" promptText="Customer gives, e.g. 1000.00"
                       prefWidth="240" styleClass="module-input"/>
            <Label text="Change" styleClass="content-description"/>
            <Label fx:id="changeLabel" text="-" styleClass="content-title"/>
        </HBox>

        <HBox fx:id="orderActions" alignment="CENTER_RIGHT"
              spacing="12">
            <Label text="Total"
                   styleClass="content-description"/>

            <Label fx:id="totalLabel"
                   text="0.00"
                   styleClass="content-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Refresh"
                    styleClass="module-button"
                    onAction="#onRefresh"/>

            <Button text="Complete order"
                    styleClass="module-button"
                    onAction="#onFinalizeSale"/>
            <Button text="Export last invoice" styleClass="module-secondary-button"
                    onAction="#onExportLastInvoice"/>
        </HBox>

    </VBox>

    <VBox spacing="18" visible="${detailsTabButton.selected}" managed="${detailsTabButton.selected}">

        <VBox spacing="8">
            <Button text="Export invoice" onAction="#onExportInvoice" styleClass="module-button"/>
            <Label text="Recent orders"
                   styleClass="content-description"/>

            <TableView fx:id="orderTable"
                       prefHeight="240">
                <columns>
                    <TableColumn fx:id="orderIdColumn"
                                 text="ID"
                                 prefWidth="80"/>

                    <TableColumn fx:id="orderUserColumn"
                                 text="User ID"
                                 prefWidth="110"/>

                    <TableColumn fx:id="orderTotalColumn"
                                 text="Total"
                                 prefWidth="140"/>

                    <TableColumn fx:id="orderCreatedAtColumn"
                                 text="Created at"
                                 prefWidth="190"/>
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="8">
            <Label text="Order details"
                   styleClass="content-description"/>

            <TableView fx:id="orderDetailTable"
                       prefHeight="220">
                <columns>
                    <TableColumn fx:id="detailProductColumn"
                                 text="Product"
                                 prefWidth="240"/>

                    <TableColumn fx:id="detailSkuColumn"
                                 text="SKU"
                                 prefWidth="130"/>

                    <TableColumn fx:id="detailQuantityColumn"
                                 text="Quantity"
                                 prefWidth="80"/>

                    <TableColumn fx:id="detailUnitPriceColumn"
                                 text="Unit price"
                                 prefWidth="120"/>

                    <TableColumn fx:id="detailSubtotalColumn"
                                 text="Subtotal"
                                 prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>

        <Button text="Refresh"
                styleClass="module-button"
                disable="${orderTable.disabled}"
                onAction="#onRefresh"/>
    </VBox>

    <Label fx:id="statusLabel"
           text="Ready" visible="false" managed="false"
           styleClass="content-description"/>

    <padding>
        <Insets top="0"
                right="0"
                bottom="0"
                left="0"/>
    </padding>
</VBox>
