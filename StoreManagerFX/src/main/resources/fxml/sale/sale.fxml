<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.sale.view.SaleController"
      spacing="14"
      styleClass="module-screen, sale-workspace">

    <VBox spacing="5" styleClass="module-header">
        <Label text="Point of Sale" styleClass="content-title"/>
        <Label text="Create in-store orders, manage the cart and review completed sales."
               styleClass="content-description"/>
    </VBox>

    <fx:define>
        <ToggleGroup fx:id="orderViewGroup"/>
    </fx:define>

    <HBox spacing="8">
        <ToggleButton fx:id="orderTabButton" text="New sale" selected="true"
                      toggleGroup="$orderViewGroup"
                      styleClass="module-button, order-tab-button"
                      onAction="#onShowOrder"/>
        <ToggleButton fx:id="detailsTabButton" text="Order history"
                      toggleGroup="$orderViewGroup"
                      styleClass="module-button, order-tab-button"
                      onAction="#onShowOrderDetails"/>
    </HBox>

    <VBox spacing="14" visible="${orderTabButton.selected}" managed="${orderTabButton.selected}">

        <HBox spacing="14" alignment="TOP_LEFT" styleClass="sale-selection-row">
            <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="product-picker-panel">
                <VBox spacing="2">
                    <Label text="Choose product" styleClass="section-label"/>
                    <Label text="Search the catalog and select an item to add to this order."
                           styleClass="muted-label"/>
                </VBox>
                <fx:include fx:id="productSelectionWorkflow"
                            source="../shared/product-selection-workflow.fxml"/>
            </VBox>

            <VBox spacing="12" prefWidth="470" minWidth="450" maxWidth="520"
                  styleClass="product-preview-card">
                <VBox spacing="2">
                    <Label text="Selected product" styleClass="section-label"/>
                    <Label fx:id="selectedProductPreviewMessageLabel"
                           text="Select a product to preview"
                           styleClass="muted-label"/>
                </VBox>

                <HBox spacing="13" alignment="CENTER_LEFT">
                    <StackPane prefWidth="100" prefHeight="100"
                               minWidth="100" minHeight="100"
                               maxWidth="100" maxHeight="100"
                               alignment="CENTER"
                               styleClass="product-image-frame">
                        <ImageView fx:id="selectedProductImageView"
                                   fitWidth="86" fitHeight="86"
                                   preserveRatio="true" smooth="true" pickOnBounds="true"/>
                        <Label fx:id="selectedProductImagePlaceholderLabel"
                               text="No image" visible="false" managed="false"
                               styleClass="muted-label"/>
                    </StackPane>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label fx:id="selectedProductPreviewNameLabel"
                               text="Name: -" wrapText="true" styleClass="product-name"/>
                        <Label fx:id="selectedProductPreviewSkuLabel"
                               text="SKU: -" styleClass="analytics-card-detail"/>
                        <Label fx:id="selectedProductPreviewPriceLabel"
                               text="Unit price: 0.00" styleClass="analytics-card-detail"/>
                        <Label fx:id="selectedProductPreviewStockLabel"
                               text="Stock: N/A" styleClass="analytics-card-detail"/>
                    </VBox>
                </HBox>

                <HBox fx:id="cartActions" alignment="CENTER_LEFT" styleClass="action-strip">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="quantityField"
                                       promptText="Quantity"
                                       prefWidth="120"
                                       minWidth="110"
                                       styleClass="module-input"/>
                            <Button text="Add to cart"
                                    maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS"
                                    styleClass="primary-button, cart-main-action"
                                    onAction="#onAddToCart"/>
                        </HBox>

                        <Button text="Update quantity"
                                maxWidth="Infinity"
                                styleClass="module-button, cart-secondary-action, cart-block-action"
                                onAction="#onUpdateQuantity"/>

                        <Button text="Remove item"
                                maxWidth="Infinity"
                                styleClass="danger-button, cart-secondary-action, cart-block-action"
                                onAction="#onRemoveItem"/>

                        <Button text="Clear cart"
                                maxWidth="Infinity"
                                styleClass="ghost-button, cart-secondary-action, cart-block-action"
                                onAction="#onClearCart"/>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>

        <VBox spacing="9" styleClass="module-panel, soft-blue">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Cart" styleClass="section-label"/>
                    <Label text="Items currently included in this order." styleClass="muted-label"/>
                </VBox>
                <Label text="Review quantity and price before checkout" styleClass="muted-label"/>
            </HBox>

            <TableView fx:id="cartTable" prefHeight="215">
                <columns>
                    <TableColumn fx:id="cartProductColumn" text="Product" prefWidth="250"/>
                    <TableColumn fx:id="cartSkuColumn" text="SKU" prefWidth="120"/>
                    <TableColumn fx:id="cartQuantityColumn" text="Quantity" prefWidth="90"/>
                    <TableColumn fx:id="cartUnitPriceColumn" text="Unit price" prefWidth="125"/>
                    <TableColumn fx:id="cartSubtotalColumn" text="Subtotal" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>

        <HBox fx:id="orderActions" spacing="12" alignment="CENTER_LEFT" styleClass="payment-bar">
            <VBox spacing="3">
                <Label text="Amount received" styleClass="muted-label"/>
                <TextField fx:id="amountReceivedField"
                           promptText="Customer gives, e.g. 1000.00"
                           prefWidth="220" styleClass="module-input"/>
            </VBox>

            <VBox spacing="3" minWidth="120">
                <Label text="Change" styleClass="muted-label"/>
                <Label fx:id="changeLabel" text="-" styleClass="change-value"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox spacing="1" styleClass="total-box">
                <Label text="ORDER TOTAL" styleClass="total-caption"/>
                <Label fx:id="totalLabel" text="0.00" styleClass="total-value"/>
            </VBox>

            <Button text="Refresh" styleClass="ghost-button" onAction="#onRefresh"/>
            <Button text="Complete order" styleClass="primary-button" onAction="#onFinalizeSale"/>
            <Button text="Export invoice" styleClass="module-button" onAction="#onExportLastInvoice"/>
        </HBox>
    </VBox>

    <VBox spacing="14" visible="${detailsTabButton.selected}" managed="${detailsTabButton.selected}">
        <HBox spacing="14" alignment="TOP_LEFT">
            <VBox spacing="9" HBox.hgrow="ALWAYS" styleClass="module-panel, soft-indigo">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Recent orders" styleClass="section-label"/>
                        <Label text="Select an order to inspect its line items." styleClass="muted-label"/>
                    </VBox>
                    <Button text="Export invoice" onAction="#onExportInvoice" styleClass="module-button"/>
                </HBox>

                <TableView fx:id="orderTable" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="orderIdColumn" text="ID" prefWidth="75"/>
                        <TableColumn fx:id="orderUserColumn" text="User ID" prefWidth="100"/>
                        <TableColumn fx:id="orderTotalColumn" text="Total" prefWidth="130"/>
                        <TableColumn fx:id="orderCreatedAtColumn" text="Created at" prefWidth="180"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="9" HBox.hgrow="ALWAYS" styleClass="module-panel, soft-blue">
                <VBox spacing="2">
                    <Label text="Order details" styleClass="section-label"/>
                    <Label text="Products and quantities in the selected order." styleClass="muted-label"/>
                </VBox>

                <TableView fx:id="orderDetailTable" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="detailProductColumn" text="Product" prefWidth="220"/>
                        <TableColumn fx:id="detailSkuColumn" text="SKU" prefWidth="120"/>
                        <TableColumn fx:id="detailQuantityColumn" text="Qty" prefWidth="70"/>
                        <TableColumn fx:id="detailUnitPriceColumn" text="Unit price" prefWidth="115"/>
                        <TableColumn fx:id="detailSubtotalColumn" text="Subtotal" prefWidth="125"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>

        <HBox alignment="CENTER_RIGHT">
            <Button text="Refresh orders"
                    styleClass="module-button"
                    disable="${orderTable.disabled}"
                    onAction="#onRefresh"/>
        </HBox>
    </VBox>

    <Label fx:id="statusLabel" text="Ready" visible="false" managed="false" styleClass="content-description"/>

    <padding><Insets top="0" right="0" bottom="0" left="0"/></padding>
</VBox>
