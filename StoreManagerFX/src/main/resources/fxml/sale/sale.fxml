<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.sale.view.SaleController"
      spacing="18">

    <VBox spacing="6">
        <Label text="Sale"
               styleClass="content-title"/>

        <Label text="Create sale orders and reduce inventory with transaction history."
               styleClass="content-description"/>
    </VBox>

    <VBox spacing="14">
        <fx:include fx:id="productSelectionWorkflow"
                    source="../shared/product-selection-workflow.fxml"/>

        <HBox spacing="12">
            <TextField fx:id="quantityField"
                       promptText="Qty"
                       prefWidth="90"
                       styleClass="module-input"/>

            <Button text="Add"
                    styleClass="module-button"
                    onAction="#onAddToCart"/>

            <Button text="Remove"
                    styleClass="module-button"
                    onAction="#onRemoveItem"/>

            <Button text="Clear"
                    styleClass="module-button"
                    onAction="#onClearCart"/>
        </HBox>
    </VBox>

    <VBox spacing="8">
        <Label text="Cart"
               styleClass="content-description"/>

        <TableView fx:id="cartTable"
                   prefHeight="250">
            <columns>
                <TableColumn fx:id="cartProductColumn"
                             text="Product"
                             prefWidth="240"/>

                <TableColumn fx:id="cartSkuColumn"
                             text="SKU"
                             prefWidth="130"/>

                <TableColumn fx:id="cartQuantityColumn"
                             text="Qty"
                             prefWidth="80"/>

                <TableColumn fx:id="cartUnitPriceColumn"
                             text="Unit price"
                             prefWidth="120"/>

                <TableColumn fx:id="cartSubtotalColumn"
                             text="Subtotal"
                             prefWidth="130"/>
            </columns>
        </TableView>
    </VBox>

    <HBox alignment="CENTER_RIGHT"
          spacing="12">
        <Label text="Total"
               styleClass="content-description"/>

        <Label fx:id="totalLabel"
               text="0.00"
               styleClass="content-title"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Refresh"
                styleClass="module-button"
                onAction="#onRefresh"/>

        <Button text="Finalize Sale"
                styleClass="module-button"
                onAction="#onFinalizeSale"/>
    </HBox>

    <VBox spacing="8">
        <Label text="Recent orders"
               styleClass="content-description"/>

        <TableView fx:id="orderTable"
                   prefHeight="240">
            <columns>
                <TableColumn fx:id="orderIdColumn"
                             text="ID"
                             prefWidth="80"/>

                <TableColumn fx:id="orderUserColumn"
                             text="User ID"
                             prefWidth="110"/>

                <TableColumn fx:id="orderTotalColumn"
                             text="Total"
                             prefWidth="140"/>

                <TableColumn fx:id="orderCreatedAtColumn"
                             text="Created at"
                             prefWidth="190"/>
            </columns>
        </TableView>
    </VBox>

    <Label fx:id="statusLabel"
           text="Ready"
           styleClass="content-description"/>

    <padding>
        <Insets top="0"
                right="0"
                bottom="0"
                left="0"/>
    </padding>
</VBox>
