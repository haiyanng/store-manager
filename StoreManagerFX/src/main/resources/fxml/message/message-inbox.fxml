<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.message.view.MessageInboxController"
      fx:id="rootPane"
      spacing="16"
      styleClass="dashboard-home">

    <VBox spacing="4">
        <Label fx:id="titleLabel"
               text="Messages"
               styleClass="content-title"/>
        <Label fx:id="subtitleLabel"
               text="Operational direct messages between users"
               styleClass="content-description"/>
    </VBox>

    <HBox spacing="12">
        <Label fx:id="conversationLabel"
               text="No conversation selected"
               styleClass="content-description"/>
        <Label fx:id="unreadLabel"
               text="Unread: 0"
               styleClass="content-description"/>
    </HBox>

    <SplitPane dividerPositions="0.34">
        <items>
            <VBox spacing="10">
                <HBox spacing="10">
                    <Label text="Conversations"
                           styleClass="analytics-section-title"/>
                    <Button fx:id="refreshButton"
                            text="Refresh"
                            onAction="#onRefresh"
                            styleClass="ghost-button"/>
                </HBox>

                <TableView fx:id="conversationTable"
                           VBox.vgrow="ALWAYS"
                           styleClass="analytics-table">
                    <columns>
                        <TableColumn fx:id="conversationUserColumn"
                                     text="User"
                                     prefWidth="180"/>
                        <TableColumn fx:id="conversationPreviewColumn"
                                     text="Last message"
                                     prefWidth="260"/>
                        <TableColumn fx:id="conversationTimeColumn"
                                     text="Last time"
                                     prefWidth="150"/>
                        <TableColumn fx:id="conversationUnreadColumn"
                                     text="Unread"
                                     prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="10">
                <Label text="Message history"
                       styleClass="analytics-section-title"/>

                <TableView fx:id="historyTable"
                           VBox.vgrow="ALWAYS"
                           styleClass="analytics-table">
                    <columns>
                        <TableColumn fx:id="historyTimeColumn"
                                     text="Time"
                                     prefWidth="160"/>
                        <TableColumn fx:id="historySenderColumn"
                                     text="Sender"
                                     prefWidth="180"/>
                        <TableColumn fx:id="historyContentColumn"
                                     text="Content"
                                     prefWidth="420"/>
                        <TableColumn fx:id="historyReadColumn"
                                     text="Read"
                                     prefWidth="80"/>
                    </columns>
                </TableView>

                <VBox spacing="8"
                      styleClass="analytics-section">
                    <Label text="Compose"
                           styleClass="analytics-section-title"/>

                    <TextArea fx:id="messageInput"
                              promptText="Write a message..."
                              prefRowCount="4"
                              wrapText="true"/>

                    <HBox spacing="10">
                        <Button fx:id="sendButton"
                                text="Send message"
                                onAction="#onSendMessage"
                                styleClass="primary-button"/>
                        <Label fx:id="statusLabel"
                               text="Ready" visible="false" managed="false"
                               styleClass="content-description"/>
                    </HBox>
                </VBox>
            </VBox>
        </items>
    </SplitPane>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
