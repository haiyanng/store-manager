<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.system_tool.view.SystemToolController"
      spacing="24"
      styleClass="module-screen">

    <stylesheets>
        <URL value="@../dashboard/dashboard-shell.css"/>
        <URL value="@../../css/typography.css"/>
    </stylesheets>

    <VBox spacing="6" styleClass="module-header">
        <Label text="System Tools"
               styleClass="content-title"/>

        <Label text="Backup &amp; Restore for disaster recovery, and Migration &amp; Export for portable business snapshots."
               styleClass="content-description"/>
    </VBox>

    <HBox spacing="18" fillHeight="true">
        <VBox spacing="14"
              styleClass="analytics-card"
              minWidth="360"
              prefWidth="420">
            <Label text="Create Backup"
                   styleClass="analytics-card-title"/>

            <Label text="Complete ZIP backup includes the database and all stored images."
                   wrapText="true" styleClass="content-description"/>

            <Label fx:id="latestBackupTimeLabel"
                   text="No backup yet"
                   styleClass="analytics-card-value"/>

            <Label fx:id="latestBackupSizeLabel"
                   text="Size: -"
                   styleClass="analytics-card-detail"/>

            <Label fx:id="backupLocationLabel"
                   text="Location: -"
                   styleClass="analytics-card-detail"/>

            <VBox spacing="8">
                <Label text="mysql executable"
                       styleClass="meta-label"/>

                <TextField fx:id="mysqlPathField"
                           promptText="mysql"
                           maxWidth="Infinity"
                           styleClass="module-input"/>

                <Label text="mysqldump executable"
                       styleClass="meta-label"/>

                <TextField fx:id="mysqldumpPathField"
                           promptText="mysqldump"
                           maxWidth="Infinity"
                           styleClass="module-input"/>
            </VBox>

            <Button fx:id="backupButton"
                    text="Create Backup"
                    styleClass="primary-button"
                    maxWidth="Infinity"
                    onAction="#onBackup"/>
        </VBox>

        <VBox spacing="14"
              styleClass="analytics-card"
              minWidth="360"
              prefWidth="420">
            <Label text="Restore Backup"
                   styleClass="analytics-card-title"/>

            <Label fx:id="restoreWarningLabel"
                   text="ZIP restore replaces the database and images. Legacy SQL restores the database only."
                   wrapText="true"
                   styleClass="logout-button"/>

            <Button fx:id="restoreButton"
                    text="Select Backup File"
                    styleClass="module-button"
                    maxWidth="Infinity"
                    onAction="#onRestore"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <fx:include source="migration-export.fxml"/>

    <Label fx:id="statusLabel"
           text="Ready" visible="false" managed="false"
           styleClass="content-description"/>

    <padding>
        <Insets top="0"
                right="0"
                bottom="0"
                left="0"/>
    </padding>
</VBox>
