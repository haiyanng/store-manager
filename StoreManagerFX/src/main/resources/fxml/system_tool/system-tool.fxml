<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.system_tool.view.SystemToolController"
      spacing="18">

    <VBox spacing="6">
        <Label text="System Tools"
               styleClass="content-title"/>

        <Label text="Local MySQL backup and restore"
               styleClass="content-description"/>
    </VBox>

    <VBox spacing="10">
        <Label text="mysql executable"
               styleClass="meta-label"/>

        <TextField fx:id="mysqlPathField"
                   promptText="mysql"
                   maxWidth="Infinity"
                   styleClass="module-input"/>

        <Label text="mysqldump executable"
               styleClass="meta-label"/>

        <TextField fx:id="mysqldumpPathField"
                   promptText="mysqldump"
                   maxWidth="Infinity"
                   styleClass="module-input"/>
    </VBox>

    <HBox spacing="10">
        <Button fx:id="backupButton"
                text="Backup"
                styleClass="module-button"
                onAction="#onBackup"/>

        <Button fx:id="restoreButton"
                text="Restore"
                styleClass="module-button"
                onAction="#onRestore"/>
    </HBox>

    <Label fx:id="statusLabel"
           text="Ready"
           styleClass="content-description"/>

    <padding>
        <Insets top="0"
                right="0"
                bottom="0"
                left="0"/>
    </padding>
</VBox>
