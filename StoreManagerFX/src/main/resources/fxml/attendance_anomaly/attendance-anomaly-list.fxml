<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.attendance_anomaly.view.AttendanceAnomalyListController"
      spacing="18"
      styleClass="module-screen, anomaly-screen">

    <VBox spacing="6" styleClass="module-header">
        <Label text="Attendance Anomalies"
               styleClass="content-title"/>

        <Label text="Review unusual attendance records and resolve them with audit support."
               styleClass="content-description"/>
    </VBox>

    <VBox spacing="12" styleClass="module-panel, soft-blue">
        <HBox spacing="10">
            <ComboBox fx:id="statusFilterComboBox" prefWidth="150" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="typeFilterComboBox" prefWidth="170" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="severityFilterComboBox" prefWidth="150" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="employeeFilterComboBox" prefWidth="210" HBox.hgrow="ALWAYS"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <DatePicker fx:id="fromDatePicker" promptText="From" prefWidth="180"/>
            <DatePicker fx:id="toDatePicker" promptText="To" prefWidth="180"/>
            <Button fx:id="applyFilterButton" text="Apply" onAction="#onApplyFilters" styleClass="primary-button"/>
            <Button fx:id="clearFilterButton" text="Clear filters" onAction="#onClearFilters" styleClass="ghost-button"/>
            <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh" styleClass="module-button"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>

    <VBox spacing="10" styleClass="module-panel, soft-indigo">
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Anomaly records" styleClass="section-label"/>
                <Label text="The table now spans the full working area for easier scanning and filtering."
                       styleClass="muted-label"/>
            </VBox>
        </HBox>

        <TableView fx:id="anomalyTable"
                   prefHeight="420"
                   prefWidth="1280"
                   VBox.vgrow="ALWAYS"
                   HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="anomalyIdColumn" text="ID" prefWidth="70"/>
                <TableColumn fx:id="anomalyEmployeeColumn" text="Employee" prefWidth="190"/>
                <TableColumn fx:id="anomalyTypeColumn" text="Type" prefWidth="190"/>
                <TableColumn fx:id="anomalySeverityColumn" text="Severity" prefWidth="110"/>
                <TableColumn fx:id="anomalyStatusColumn" text="Status" prefWidth="120"/>
                <TableColumn fx:id="anomalyCreatedAtColumn" text="Created at" prefWidth="170"/>
                <TableColumn fx:id="anomalyMessageColumn" text="Message" prefWidth="430"/>
            </columns>
        </TableView>
    </VBox>

    <HBox spacing="16" alignment="TOP_LEFT" fillHeight="true">
        <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="module-panel, detail-form-card">
            <fx:include fx:id="anomalyForm"
                        source="attendance-anomaly-form.fxml"/>
        </VBox>

        <VBox spacing="12" prefWidth="280" minWidth="250" maxWidth="320" styleClass="module-panel, action-card, soft-green">
            <VBox spacing="4">
                <Label text="Actions" styleClass="section-label"/>
                <Label text="Run the appropriate resolution workflow for the selected anomaly."
                       styleClass="muted-label" wrapText="true"/>
            </VBox>

            <VBox fx:id="managerActionsBox" spacing="8">
                <Button fx:id="submitReportButton"
                        text="Submit report"
                        styleClass="module-button"
                        maxWidth="Infinity"
                        onAction="#onSubmitReport"/>
            </VBox>

            <VBox fx:id="adminActionsBox" spacing="8">
                <Button fx:id="resolveButton"
                        text="Resolve"
                        styleClass="primary-button"
                        maxWidth="Infinity"
                        onAction="#onResolve"/>

                <Button fx:id="dismissButton"
                        text="Dismiss"
                        styleClass="danger-button"
                        maxWidth="Infinity"
                        onAction="#onDismiss"/>

                <Button fx:id="saveAttendanceButton"
                        text="Save attendance changes"
                        styleClass="module-button"
                        maxWidth="Infinity"
                        onAction="#onSaveAttendanceEdits"/>

                <Button fx:id="updateNotificationButton"
                        text="Update employee notification"
                        styleClass="ghost-button"
                        maxWidth="Infinity"
                        onAction="#onUpdateEmployeeNotification"/>
            </VBox>
        </VBox>
    </HBox>

    <Label fx:id="statusLabel"
           text="Ready" visible="false" managed="false"
           styleClass="content-description"/>

    <padding>
        <Insets top="0"
                right="0"
                bottom="0"
                left="0"/>
    </padding>
</VBox>
