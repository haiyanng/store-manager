<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.attendance_anomaly.view.AttendanceAnomalyFormController"
      spacing="12"
      styleClass="anomaly-form-root">

    <VBox spacing="3">
        <Label text="Anomaly detail" styleClass="section-label"/>
        <Label text="Inspect the selected anomaly and adjust attendance data if needed."
               styleClass="muted-label"/>
    </VBox>

    <HBox spacing="14" alignment="TOP_LEFT">
        <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="detail-section">
            <HBox spacing="10" styleClass="detail-row">
                <Label text="ID" styleClass="detail-inline-label"/>
                <Label fx:id="anomalyIdLabel" text="-" styleClass="detail-inline-value"/>
            </HBox>
            <HBox spacing="10" styleClass="detail-row">
                <Label text="Attendance session" styleClass="detail-inline-label"/>
                <Label fx:id="attendanceSessionIdLabel" text="-" styleClass="detail-inline-value" wrapText="true"/>
            </HBox>
            <HBox spacing="10" styleClass="detail-row">
                <Label text="Employee" styleClass="detail-inline-label"/>
                <Label fx:id="employeeLabel" text="-" styleClass="detail-inline-value" wrapText="true"/>
            </HBox>
            <HBox spacing="10" styleClass="detail-row">
                <Label text="Type" styleClass="detail-inline-label"/>
                <Label fx:id="typeLabel" text="-" styleClass="detail-inline-value" wrapText="true"/>
            </HBox>
            <HBox spacing="10" styleClass="detail-row">
                <Label text="Severity" styleClass="detail-inline-label"/>
                <Label fx:id="severityLabel" text="-" styleClass="detail-inline-value"/>
            </HBox>
        </VBox>

        <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="detail-section">
            <HBox spacing="10" styleClass="detail-row">
                <Label text="Status" styleClass="detail-inline-label"/>
                <Label fx:id="statusLabel" text="-" styleClass="detail-inline-value"/>
            </HBox>
            <HBox spacing="10" styleClass="detail-row">
                <Label text="Created at" styleClass="detail-inline-label"/>
                <Label fx:id="createdAtLabel" text="-" styleClass="detail-inline-value" wrapText="true"/>
            </HBox>
            <HBox spacing="10" styleClass="detail-row">
                <Label text="Resolved by" styleClass="detail-inline-label"/>
                <Label fx:id="resolvedByLabel" text="-" styleClass="detail-inline-value" wrapText="true"/>
            </HBox>
            <HBox spacing="10" styleClass="detail-row">
                <Label text="Resolved at" styleClass="detail-inline-label"/>
                <Label fx:id="resolvedAtLabel" text="-" styleClass="detail-inline-value" wrapText="true"/>
            </HBox>
        </VBox>
    </HBox>

    <VBox spacing="8">
        <Label text="Anomaly message" styleClass="record-field-label"/>
        <TextArea fx:id="messageArea"
                  promptText="Anomaly message"
                  editable="false"
                  wrapText="true"
                  prefRowCount="4"
                  styleClass="module-input"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Manager report" styleClass="record-field-label"/>
        <TextArea fx:id="managerReportArea"
                  promptText="Manager report"
                  wrapText="true"
                  prefRowCount="4"
                  styleClass="module-input"/>
    </VBox>

    <CheckBox fx:id="employeeNotificationCheckBox"
              text="Notify employee"/>

    <VBox spacing="8" styleClass="soft-blue, anomaly-edit-box">
        <Label text="Attendance edit" styleClass="section-label"/>

        <TextField fx:id="checkInField"
                   promptText="Check-in yyyy-MM-dd HH:mm:ss"
                   styleClass="module-input"/>

        <TextField fx:id="checkOutField"
                   promptText="Check-out yyyy-MM-dd HH:mm:ss"
                   styleClass="module-input"/>

        <TextField fx:id="workedHoursField"
                   promptText="Worked hours"
                   styleClass="module-input"/>
    </VBox>

    <padding>
        <Insets top="0"
                right="0"
                bottom="0"
                left="0"/>
    </padding>
</VBox>
