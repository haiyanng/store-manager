<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.payroll.view.PayrollController"
      spacing="18">

    <VBox spacing="6">
        <Label text="Payroll"
               styleClass="content-title"/>

        <Label text="Generate auditable payroll snapshots from attendance totals."
               styleClass="content-description"/>
    </VBox>

    <HBox fx:id="salaryConfigControls"
          spacing="12">
        <ComboBox fx:id="employeeComboBox"
                  promptText="Employee"
                  prefWidth="300"/>

        <TextField fx:id="hourlyRateField"
                   promptText="Hourly rate"
                   prefWidth="140"
                   styleClass="module-input"/>

        <CheckBox fx:id="activeCheckBox"
                  text="Active"/>

        <Button text="Save Salary"
                styleClass="module-button"
                onAction="#onSaveSalaryConfig"/>
    </HBox>

    <HBox fx:id="payrollGenerationControls"
          spacing="12">
        <TextField fx:id="yearField"
                   promptText="Year"
                   prefWidth="100"
                   styleClass="module-input"/>

        <TextField fx:id="monthField"
                   promptText="Month"
                   prefWidth="100"
                   styleClass="module-input"/>

        <Button text="Generate Payroll"
                styleClass="module-button"
                onAction="#onGeneratePayroll"/>

        <Button text="Refresh"
                styleClass="module-button"
                onAction="#onRefresh"/>
    </HBox>

    <VBox fx:id="salaryConfigSection"
          spacing="8">
        <Label text="Salary configuration"
               styleClass="content-description"/>

        <TableView fx:id="salaryConfigTable"
                   prefHeight="220">
            <columns>
                <TableColumn fx:id="configEmployeeColumn"
                             text="Employee"
                             prefWidth="240"/>

                <TableColumn fx:id="configRateColumn"
                             text="Hourly rate"
                             prefWidth="130"/>

                <TableColumn fx:id="configActiveColumn"
                             text="Active"
                             prefWidth="90"/>

                <TableColumn fx:id="configUpdatedAtColumn"
                             text="Updated at"
                             prefWidth="190"/>
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="8">
        <Label text="Payroll history"
               styleClass="content-description"/>

        <TableView fx:id="payrollTable"
                   prefHeight="300">
            <columns>
                <TableColumn fx:id="payrollEmployeeColumn"
                             text="Employee"
                             prefWidth="220"/>

                <TableColumn fx:id="payrollMonthColumn"
                             text="Month"
                             prefWidth="80"/>

                <TableColumn fx:id="payrollYearColumn"
                             text="Year"
                             prefWidth="90"/>

                <TableColumn fx:id="payrollHoursColumn"
                             text="Hours"
                             prefWidth="90"/>

                <TableColumn fx:id="payrollRateColumn"
                             text="Rate snapshot"
                             prefWidth="130"/>

                <TableColumn fx:id="payrollSalaryColumn"
                             text="Total salary"
                             prefWidth="140"/>

                <TableColumn fx:id="payrollGeneratedAtColumn"
                             text="Generated at"
                             prefWidth="190"/>
            </columns>
        </TableView>
    </VBox>

    <Label fx:id="statusLabel"
           text="Ready"
           styleClass="content-description"/>

    <padding>
        <Insets top="0"
                right="0"
                bottom="0"
                left="0"/>
    </padding>
</VBox>
