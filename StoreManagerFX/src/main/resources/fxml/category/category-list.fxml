<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.category.view.CategoryListController"
      spacing="18">

    <VBox spacing="6">
        <Label text="Category"
               styleClass="content-title"/>

        <Label text="Manage lightweight catalog reference data."
               styleClass="content-description"/>
    </VBox>

    <HBox spacing="16">
        <fx:include fx:id="categoryForm"
                    source="category-form.fxml"/>

        <VBox spacing="10">
            <Button text="Create"
                    styleClass="module-button"
                    maxWidth="Infinity"
                    onAction="#onCreate"/>

            <Button fx:id="updateButton"
                    text="Update"
                    styleClass="module-button"
                    maxWidth="Infinity"
                    onAction="#onUpdate"/>

            <Button fx:id="deactivateButton"
                    text="Deactivate"
                    styleClass="module-button"
                    maxWidth="Infinity"
                    onAction="#onDeactivate"/>

            <Button text="Clear"
                    styleClass="module-button"
                    maxWidth="Infinity"
                    onAction="#onClear"/>

            <Button text="Refresh"
                    styleClass="module-button"
                    maxWidth="Infinity"
                    onAction="#onRefresh"/>
        </VBox>
    </HBox>

    <TableView fx:id="categoryTable"
               VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn"
                         text="ID"
                         prefWidth="70"/>

            <TableColumn fx:id="nameColumn"
                         text="Name"
                         prefWidth="220"/>

            <TableColumn fx:id="imageColumn"
                         text="Image"
                         prefWidth="120"/>

            <TableColumn fx:id="activeColumn"
                         text="Active"
                         prefWidth="90"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel"
           text="Ready"
           styleClass="content-description"/>

    <padding>
        <Insets top="0"
                right="0"
                bottom="0"
                left="0"/>
    </padding>
</VBox>
