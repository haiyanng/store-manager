<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"

      fx:controller="com.storemanager.domain.auth.view.LoginController"

      alignment="CENTER"
      spacing="12">

    <padding>
        <Insets top="32"
                right="32"
                bottom="32"
                left="32"/>
    </padding>

    <TextField
            fx:id="usernameField"
            promptText="Username"/>

    <PasswordField
            fx:id="passwordField"
            promptText="Password"/>

    <Button
            text="Login"
            onAction="#onLogin"/>

</VBox>