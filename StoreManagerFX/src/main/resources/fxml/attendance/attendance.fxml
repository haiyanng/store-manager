<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.attendance.view.AttendanceController"
      spacing="18">

    <VBox spacing="6">
        <Label text="Attendance"
               styleClass="content-title"/>

        <Label text="Track employee work sessions."
               styleClass="content-description"/>

        <Label fx:id="sessionStatusLabel"
               text="Session: no active session"
               styleClass="content-description"/>
    </VBox>

    <HBox spacing="12">
        <ComboBox fx:id="employeeComboBox"
                  promptText="Employee"
                  prefWidth="320"/>

        <Button fx:id="checkInButton" text="Check in"
                styleClass="module-button"
                onAction="#onCheckIn"/>

        <Button fx:id="checkOutButton" text="Check out"
                styleClass="module-button"
                onAction="#onCheckOut"/>

        <Button fx:id="refreshButton" text="Refresh"
                styleClass="module-button"
                onAction="#onRefresh"/>
    </HBox>

    <VBox spacing="8">
        <Label text="Attendance history"
               styleClass="content-description"/>

        <TableView fx:id="sessionTable"
                   prefHeight="320">
            <columns>
                <TableColumn fx:id="sessionIdColumn"
                             text="ID"
                             prefWidth="70"/>

                <TableColumn fx:id="sessionEmployeeColumn"
                             text="Employee"
                             prefWidth="220"/>

                <TableColumn fx:id="checkInColumn"
                             text="Check in"
                             prefWidth="180"/>

                <TableColumn fx:id="checkOutColumn"
                             text="Check out"
                             prefWidth="180"/>

                <TableColumn fx:id="workedHoursColumn"
                             text="Hours"
                             prefWidth="90"/>

                <TableColumn fx:id="createdByColumn"
                             text="User ID"
                             prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="8">
        <Label text="Current month totals"
               styleClass="content-description"/>

        <TableView fx:id="monthlyTable"
                   prefHeight="220">
            <columns>
                <TableColumn fx:id="monthlyEmployeeColumn"
                             text="Employee"
                             prefWidth="240"/>

                <TableColumn fx:id="monthlyMonthColumn"
                             text="Month"
                             prefWidth="120"/>

                <TableColumn fx:id="monthlyHoursColumn"
                             text="Total hours"
                             prefWidth="130"/>
            </columns>
        </TableView>
    </VBox>

    <Label fx:id="statusLabel"
           text="Ready" visible="false" managed="false"
           styleClass="content-description"/>

    <padding>
        <Insets top="0"
                right="0"
                bottom="0"
                left="0"/>
    </padding>
</VBox>
