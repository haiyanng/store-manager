<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.inventory.view.InventoryAdjustmentFormController"
      spacing="10">

    <fx:include fx:id="productSelectionWorkflow"
                source="../shared/product-selection-workflow.fxml"/>

    <Label text="Transaction type"
           styleClass="analytics-section-title"/>

    <ComboBox fx:id="typeComboBox"
              promptText="Transaction type"
              maxWidth="Infinity"/>

    <TextField fx:id="quantityField"
               promptText="Quantity"
               maxWidth="Infinity"
               styleClass="module-input"/>

    <TextField fx:id="reasonField"
               promptText="Reason"
               maxWidth="Infinity"
               styleClass="module-input"/>
</VBox>
