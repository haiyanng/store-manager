<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.inventory.view.InventoryListController"
      spacing="18">

    <VBox spacing="6">
        <Label text="View Inventory"
               styleClass="content-title"/>

        <Label text="Track current stock and auditable stock movements."
               styleClass="content-description"/>
    </VBox>

    <Button text="Refresh"
            styleClass="module-button"
            onAction="#onRefresh"/>

    <VBox spacing="8">
        <Label text="Current stock"
               styleClass="content-description"/>

        <TableView fx:id="inventoryTable"
                   prefHeight="230">
            <columns>
                <TableColumn fx:id="itemIdColumn"
                             text="ID"
                             prefWidth="70"/>

                <TableColumn fx:id="itemProductColumn"
                             text="Product"
                             prefWidth="220"/>

                <TableColumn fx:id="itemSkuColumn"
                             text="SKU"
                             prefWidth="130"/>

                <TableColumn fx:id="itemQuantityColumn"
                             text="Quantity"
                             prefWidth="100"/>

                <TableColumn fx:id="itemUpdatedAtColumn"
                             text="Updated at"
                             prefWidth="180"/>
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="8">
        <Label text="Transaction history"
               styleClass="content-description"/>

        <TableView fx:id="transactionTable"
                   prefHeight="260">
            <columns>
                <TableColumn fx:id="transactionIdColumn"
                             text="ID"
                             prefWidth="70"/>

                <TableColumn fx:id="transactionProductColumn"
                             text="Product"
                             prefWidth="200"/>

                <TableColumn fx:id="transactionTypeColumn"
                             text="Type"
                             prefWidth="120"/>

                <TableColumn fx:id="transactionQuantityColumn"
                             text="Quantity"
                             prefWidth="100"/>

                <TableColumn fx:id="transactionReasonColumn"
                             text="Reason"
                             prefWidth="220"/>

                <TableColumn fx:id="transactionUserColumn"
                             text="User ID"
                             prefWidth="100"/>

                <TableColumn fx:id="transactionCreatedAtColumn"
                             text="Created at"
                             prefWidth="180"/>
            </columns>
        </TableView>
    </VBox>

    <Label fx:id="statusLabel"
           text="Ready"
           styleClass="content-description"/>

    <padding>
        <Insets top="0"
                right="0"
                bottom="0"
                left="0"/>
    </padding>
</VBox>
