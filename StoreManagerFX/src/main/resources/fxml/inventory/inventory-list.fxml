<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.inventory.view.InventoryListController"
      spacing="18"
      styleClass="module-screen">

    <VBox spacing="6" styleClass="module-header">
        <Label text="View Inventory"
               styleClass="content-title"/>

        <Label text="Track current stock and auditable stock movements."
               styleClass="content-description"/>
    </VBox>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="action-strip">
        <CheckBox fx:id="lowStockOnly" text="Low stock only (quantity &lt; 10)" onAction="#onFilter"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" styleClass="ghost-button" onAction="#onRefresh"/>
    </HBox>

    <VBox spacing="10" styleClass="module-panel, soft-blue">
        <Label text="Current stock"
               styleClass="content-description"/>

        <TableView fx:id="inventoryTable"
                   prefHeight="230">
            <columns>
                <TableColumn fx:id="itemIdColumn"
                             text="ID"
                             prefWidth="70"/>

                <TableColumn fx:id="itemProductColumn"
                             text="Product"
                             prefWidth="220"/>

                <TableColumn fx:id="itemSkuColumn"
                             text="SKU"
                             prefWidth="130"/>

                <TableColumn fx:id="itemQuantityColumn"
                             text="Quantity"
                             prefWidth="100"/>

                <TableColumn fx:id="itemUpdatedAtColumn"
                             text="Updated at"
                             prefWidth="180"/>
                <TableColumn fx:id="itemExpiryColumn" text="Nearest expiry date" prefWidth="150"/>
                <TableColumn fx:id="itemExpiryStatusColumn" text="Expiry status" prefWidth="155"/>
            </columns>
        </TableView>
        <Label text="Expiry dates use all import history; remaining stock is not tracked by batch."
               wrapText="true" styleClass="content-description"/>
    </VBox>

    <VBox spacing="10" styleClass="module-panel, soft-indigo">
        <Label text="Import history"
               styleClass="content-description"/>

        <FlowPane hgap="10" vgap="10">
            <Label text="From"/>
            <DatePicker fx:id="fromDate" promptText="Start date" prefWidth="170"/>
            <Label text="To"/>
            <DatePicker fx:id="toDate" promptText="End date" prefWidth="170"/>
            <ComboBox fx:id="filterProduct" promptText="All products" prefWidth="240"/>
            <Button text="Apply filters" onAction="#onFilter" styleClass="primary-button"/>
            <Button text="Clear filters" onAction="#onClearFilters" styleClass="module-secondary-button"/>
        </FlowPane>
        <TableView fx:id="transactionTable"
                   prefHeight="260">
            <columns>
                <TableColumn fx:id="transactionIdColumn"
                             text="ID"
                             prefWidth="70"/>

                <TableColumn fx:id="transactionProductColumn"
                             text="Product"
                             prefWidth="200"/>

                <TableColumn fx:id="transactionTypeColumn"
                             text="Type"
                             prefWidth="120"/>

                <TableColumn fx:id="transactionQuantityColumn"
                             text="Quantity"
                             prefWidth="100"/>

                <TableColumn fx:id="transactionReasonColumn"
                             text="Reason"
                             prefWidth="220"/>

                <TableColumn fx:id="transactionUserColumn"
                             text="User ID"
                             prefWidth="100"/>

                <TableColumn fx:id="transactionCreatedAtColumn"
                             text="Created at"
                             prefWidth="180"/>
            </columns>
        </TableView>
    </VBox>

    <Label fx:id="statusLabel"
           text="Ready" visible="false" managed="false"
           styleClass="content-description"/>

    <padding>
        <Insets top="0"
                right="0"
                bottom="0"
                left="0"/>
    </padding>
</VBox>
