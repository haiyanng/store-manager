<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.product.view.ProductListController"
      spacing="18">

    <VBox spacing="6">
        <Label text="Product"
               styleClass="content-title"/>

        <Label text="Manage catalog items. Stock is handled by Inventory."
               styleClass="content-description"/>
    </VBox>

    <HBox spacing="16">
        <fx:include fx:id="productForm"
                    source="product-form.fxml"/>

        <VBox spacing="10">
            <Button fx:id="createButton"
                    text="Create"
                    styleClass="module-button"
                    maxWidth="Infinity"
                    onAction="#onCreate"/>

            <Button fx:id="updateButton"
                    text="Update"
                    styleClass="module-button"
                    maxWidth="Infinity"
                    onAction="#onUpdate"/>

            <Button fx:id="deleteButton"
                    text="Delete"
                    styleClass="module-button"
                    maxWidth="Infinity"
                    onAction="#onDelete"/>

            <Button text="Clear"
                    styleClass="module-button"
                    maxWidth="Infinity"
                    onAction="#onClear"/>

            <Button text="Refresh"
                    styleClass="module-button"
                    maxWidth="Infinity"
                    onAction="#onRefresh"/>
        </VBox>
    </HBox>

    <TableView fx:id="productTable"
               VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn"
                         text="ID"
                         prefWidth="70"/>

            <TableColumn fx:id="nameColumn"
                         text="Name"
                         prefWidth="180"/>

            <TableColumn fx:id="skuColumn"
                         text="SKU"
                         prefWidth="120"/>

            <TableColumn fx:id="barcodeColumn"
                         text="Barcode"
                         prefWidth="140"/>

            <TableColumn fx:id="categoryColumn"
                         text="Category"
                         prefWidth="160"/>

            <TableColumn fx:id="basePriceColumn"
                         text="Base price"
                         prefWidth="110"/>

            <TableColumn fx:id="unitColumn"
                         text="Unit"
                         prefWidth="90"/>

            <TableColumn fx:id="activeColumn"
                         text="Active"
                         prefWidth="90"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel"
           text="Ready"
           styleClass="content-description"/>

    <padding>
        <Insets top="0"
                right="0"
                bottom="0"
                left="0"/>
    </padding>
</VBox>
