<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.product.view.ProductSelectionWorkflowController"
      spacing="10">

    <VBox spacing="4">
        <Label text="Select product"
               styleClass="analytics-section-title"/>

        <ComboBox fx:id="quickPickComboBox"
                  promptText="Choose a product"
                  maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Search"
               styleClass="analytics-section-title"/>

        <TextField fx:id="searchField"
                   promptText="Search by name or SKU"
                   maxWidth="Infinity"
                   styleClass="module-input"/>
    </VBox>

    <VBox spacing="6">
        <Label fx:id="resultCountLabel"
               text="0 products"
               styleClass="analytics-section-text"/>

        <TableView fx:id="resultTable"
                   prefHeight="220"
                   maxHeight="Infinity">
            <columns>
                <TableColumn fx:id="resultNameColumn"
                             text="Name"
                             prefWidth="240"/>

                <TableColumn fx:id="resultSkuColumn"
                             text="SKU"
                             prefWidth="130"/>

                <TableColumn fx:id="resultStockColumn"
                             text="Stock"
                             prefWidth="100" minWidth="80" style="-fx-alignment: CENTER-RIGHT;"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
