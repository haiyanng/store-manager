<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.storemanager.domain.onlineorder.view.OnlineOrderController"
            styleClass="content-shell">

    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <top>
        <VBox spacing="6">
            <Label text="Online Orders"
                   styleClass="content-title"/>
            <Label text="Read-only view of online customer orders."
                   styleClass="content-description"/>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.42"
                   orientation="HORIZONTAL">
            <VBox spacing="12"
                  prefWidth="380"
                  minWidth="330"
                  maxWidth="Infinity">
                <HBox spacing="10">
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="refreshButton"
                            text="Refresh"
                            styleClass="module-button"
                            onAction="#onRefresh"/>
                </HBox>

                <TableView fx:id="orderTable"
                           prefHeight="720"
                           minWidth="330"
                           maxWidth="Infinity"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="orderIdColumn"
                                     text="ID"
                                     prefWidth="56"/>
                        <TableColumn fx:id="orderCustomerColumn"
                                     text="Customer"
                                     prefWidth="120"/>
                        <TableColumn fx:id="orderEmailColumn"
                                     text="Email"
                                     prefWidth="160"/>
                        <TableColumn fx:id="orderStatusColumn"
                                     text="Status"
                                     prefWidth="96"/>
                        <TableColumn fx:id="orderTotalColumn"
                                     text="Total"
                                     prefWidth="96"/>
                        <TableColumn fx:id="orderCreatedAtColumn"
                                     text="Created"
                                     prefWidth="140"/>
                    </columns>
                </TableView>
            </VBox>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="AS_NEEDED"
                        vbarPolicy="AS_NEEDED">
                <content>
                    <VBox fx:id="detailBox"
                          spacing="18"
                          maxWidth="Infinity"
                          prefWidth="900"
                          styleClass="analytics-card">
                        <padding>
                            <Insets top="20"
                                    right="24"
                                    bottom="24"
                                    left="24"/>
                        </padding>

                        <VBox spacing="4">
                            <Label text="Order"
                                   styleClass="analytics-card-title"/>
                            <Label fx:id="orderIdValueLabel"
                                   text="-"
                                   styleClass="analytics-card-detail"/>
                            <Label fx:id="orderStatusValueLabel"
                                   text="-"
                                   styleClass="analytics-card-detail"/>
                            <Label fx:id="orderTotalValueLabel"
                                   text="0.00"
                                   styleClass="analytics-card-detail"/>
                            <Label fx:id="orderCreatedAtValueLabel"
                                   text="-"
                                   styleClass="analytics-card-detail"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Customer"
                                   styleClass="analytics-card-title"/>
                            <Label fx:id="customerFullNameValueLabel"
                                   text="-"
                                   styleClass="analytics-card-detail"/>
                            <Label fx:id="customerEmailValueLabel"
                                   text="-"
                                   styleClass="analytics-card-detail"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Shipping"
                                   styleClass="analytics-card-title"/>
                            <Label fx:id="recipientNameValueLabel"
                                   text="-"
                                   styleClass="analytics-card-detail"/>
                            <Label fx:id="phoneValueLabel"
                                   text="-"
                                   styleClass="analytics-card-detail"/>
                            <Label fx:id="shippingAddressValueLabel"
                                   text="-"
                                   wrapText="true"
                                   styleClass="analytics-card-detail"/>
                            <Label fx:id="paymentMethodValueLabel"
                                   text="-"
                                   styleClass="analytics-card-detail"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Workflow"
                                   styleClass="analytics-card-title"/>

                            <HBox spacing="10">
                                <Button fx:id="confirmButton"
                                        text="Confirm"
                                        styleClass="module-button"
                                        onAction="#onConfirm"/>
                                <Button fx:id="preparingButton"
                                        text="Preparing"
                                        styleClass="module-button"
                                        onAction="#onPreparing"/>
                                <Button fx:id="deliveringButton"
                                        text="Delivering"
                                        styleClass="module-button"
                                        onAction="#onDelivering"/>
                                <Button fx:id="deliveredButton"
                                        text="Delivered"
                                        styleClass="module-button"
                                        onAction="#onDelivered"/>
                                <Button fx:id="cancelButton"
                                        text="Cancel"
                                        styleClass="module-button"
                                        onAction="#onCancel"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Items"
                                   styleClass="analytics-card-title"/>

                            <TableView fx:id="itemTable"
                                       prefHeight="420"
                                       minWidth="600"
                                       maxWidth="Infinity"
                                       VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="itemProductColumn"
                                                 text="Product"
                                                 prefWidth="240"/>
                                    <TableColumn fx:id="itemQuantityColumn"
                                                 text="Qty"
                                                 prefWidth="70"/>
                                    <TableColumn fx:id="itemUnitPriceColumn"
                                                 text="Unit price"
                                                 prefWidth="120"/>
                                    <TableColumn fx:id="itemSubtotalColumn"
                                                 text="Subtotal"
                                                 prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </SplitPane>
    </center>

    <bottom>
        <Label fx:id="statusLabel"
               text="Ready"
               styleClass="content-description"/>
    </bottom>
</BorderPane>
