<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.notification.view.NotificationCenterController"
      fx:id="rootPane"
      spacing="16"
      styleClass="dashboard-home">

    <VBox spacing="4">
        <Label text="Notification Center"
               styleClass="content-title"/>
        <Label text="System-generated operational notifications"
               styleClass="content-description"/>
    </VBox>

    <HBox spacing="12">
        <Label fx:id="unreadLabel"
               text="Unread: 0"
               styleClass="content-description"/>
        <Label fx:id="statusLabel"
               text="Ready" visible="false" managed="false"
               styleClass="content-description"/>
    </HBox>

    <VBox spacing="10"
          styleClass="analytics-section">
        <HBox spacing="10">
            <Label text="Recent notifications"
                   styleClass="analytics-section-title"/>
            <Button text="Refresh"
                    onAction="#onRefresh"
                    styleClass="module-button"/>
            <Button fx:id="markAsReadButton"
                    text="Mark as read"
                    onAction="#onMarkAsRead"
                    styleClass="module-button"/>
        </HBox>

        <TableView fx:id="recentTable"
                   prefHeight="220"
                   styleClass="analytics-table">
            <columns>
                <TableColumn fx:id="recentTimeColumn"
                             text="Time"
                             prefWidth="160"/>
                <TableColumn fx:id="recentTypeColumn"
                             text="Type"
                             prefWidth="120"/>
                <TableColumn fx:id="recentTitleColumn"
                             text="Title"
                             prefWidth="280"/>
                <TableColumn fx:id="recentReadColumn"
                             text="Read"
                             prefWidth="80"/>
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="10"
          styleClass="analytics-section">
        <Label text="All notifications"
               styleClass="analytics-section-title"/>

        <TableView fx:id="notificationTable"
                   prefHeight="420"
                   styleClass="analytics-table">
            <columns>
                <TableColumn fx:id="createdAtColumn"
                             text="Created at"
                             prefWidth="170"/>
                <TableColumn fx:id="typeColumn"
                             text="Type"
                             prefWidth="120"/>
                <TableColumn fx:id="titleColumn"
                             text="Title"
                             prefWidth="250"/>
                <TableColumn fx:id="contentColumn"
                             text="Content"
                             prefWidth="420"/>
                <TableColumn fx:id="readColumn"
                             text="Read"
                             prefWidth="80"/>
            </columns>
        </TableView>
    </VBox>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
