<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.importing.view.ImportController"
      spacing="18">

    <VBox spacing="6">
        <Label text="Import"
               styleClass="content-title"/>

        <Label text="Create stock acquisition receipts and increase inventory with transaction history."
               styleClass="content-description"/>
    </VBox>

    <HBox spacing="12">
        <TextField fx:id="supplierField"
                   promptText="Supplier"
                   prefWidth="240"
                   styleClass="module-input"/>

        <ComboBox fx:id="productComboBox"
                  promptText="Product"
                  prefWidth="300"/>

        <TextField fx:id="quantityField"
                   promptText="Qty"
                   prefWidth="90"
                   styleClass="module-input"/>

        <TextField fx:id="unitCostField"
                   promptText="Unit cost"
                   prefWidth="120"
                   styleClass="module-input"/>

        <Button text="Add"
                styleClass="module-button"
                onAction="#onAddItem"/>

        <Button text="Remove"
                styleClass="module-button"
                onAction="#onRemoveItem"/>

        <Button text="Clear"
                styleClass="module-button"
                onAction="#onClearItems"/>
    </HBox>

    <VBox spacing="8">
        <Label text="Import items"
               styleClass="content-description"/>

        <TableView fx:id="importItemTable"
                   prefHeight="250">
            <columns>
                <TableColumn fx:id="itemProductColumn"
                             text="Product"
                             prefWidth="240"/>

                <TableColumn fx:id="itemSkuColumn"
                             text="SKU"
                             prefWidth="130"/>

                <TableColumn fx:id="itemQuantityColumn"
                             text="Qty"
                             prefWidth="80"/>

                <TableColumn fx:id="itemUnitCostColumn"
                             text="Unit cost"
                             prefWidth="120"/>

                <TableColumn fx:id="itemSubtotalColumn"
                             text="Subtotal"
                             prefWidth="130"/>
            </columns>
        </TableView>
    </VBox>

    <HBox alignment="CENTER_RIGHT"
          spacing="12">
        <Label text="Total cost"
               styleClass="content-description"/>

        <Label fx:id="totalLabel"
               text="0.00"
               styleClass="content-title"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Refresh"
                styleClass="module-button"
                onAction="#onRefresh"/>

        <Button text="Finalize Import"
                styleClass="module-button"
                onAction="#onFinalizeImport"/>
    </HBox>

    <VBox spacing="8">
        <Label text="Recent import receipts"
               styleClass="content-description"/>

        <TableView fx:id="receiptTable"
                   prefHeight="240">
            <columns>
                <TableColumn fx:id="receiptIdColumn"
                             text="ID"
                             prefWidth="80"/>

                <TableColumn fx:id="receiptSupplierColumn"
                             text="Supplier"
                             prefWidth="220"/>

                <TableColumn fx:id="receiptTotalColumn"
                             text="Total cost"
                             prefWidth="140"/>

                <TableColumn fx:id="receiptUserColumn"
                             text="User ID"
                             prefWidth="110"/>

                <TableColumn fx:id="receiptCreatedAtColumn"
                             text="Created at"
                             prefWidth="190"/>
            </columns>
        </TableView>
    </VBox>

    <Label fx:id="statusLabel"
           text="Ready"
           styleClass="content-description"/>

    <padding>
        <Insets top="0"
                right="0"
                bottom="0"
                left="0"/>
    </padding>
</VBox>
