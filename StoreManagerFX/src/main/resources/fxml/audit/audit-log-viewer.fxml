<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.storemanager.domain.audit.view.AuditLogController"
      spacing="16"
      styleClass="dashboard-home">

    <VBox spacing="4">
        <Label text="Audit Logs"
               styleClass="content-title"/>
        <Label text="Review who changed records, when, and what changed."
               styleClass="content-description"/>
    </VBox>

    <HBox spacing="10">
        <TextField fx:id="actionField"
                   promptText="Action"
                   styleClass="module-input"/>
        <TextField fx:id="entityTypeField"
                   promptText="Entity type"
                   styleClass="module-input"/>
        <TextField fx:id="moduleField"
                   promptText="Module"
                   styleClass="module-input"/>
        <ComboBox fx:id="successComboBox"
                  promptText="Result"/>
        <TextField fx:id="userIdField"
                   promptText="User ID"
                   styleClass="module-input"/>
        <DatePicker fx:id="fromDatePicker"/>
        <DatePicker fx:id="toDatePicker"/>
    </HBox>

    <HBox spacing="10">
        <Button fx:id="searchButton"
                text="Search"
                styleClass="module-button"
                onAction="#onSearch"/>
        <Button fx:id="clearButton"
                text="Clear filters"
                styleClass="module-button"
                onAction="#onClear"/>
    </HBox>

    <TableView fx:id="auditLogTable"
               prefHeight="340" minHeight="180" VBox.vgrow="ALWAYS"
               styleClass="analytics-table">
        <columns>
            <TableColumn fx:id="createdAtColumn" text="Created at"/>
            <TableColumn fx:id="usernameColumn" text="Actor"/>
            <TableColumn fx:id="moduleColumn" text="Module"/>
            <TableColumn fx:id="actionColumn" text="Action"/>
            <TableColumn fx:id="entityTypeColumn" text="Entity"/>
            <TableColumn fx:id="entityIdColumn" text="Entity ID"/>
            <TableColumn fx:id="successColumn" text="Result"/>
            <TableColumn fx:id="reasonColumn" text="Reason"/>
            <TableColumn fx:id="detailsJsonColumn" text="Changes" prefWidth="260"/>
        </columns>
    </TableView>

    <Label text="Event details" styleClass="record-section-title"/>
    <TextArea fx:id="eventDetailsArea" editable="false" wrapText="true"
              prefHeight="170" promptText="Select an event to inspect its changes and copy the details."/>

    <Label fx:id="statusLabel"
           text="Ready"
           styleClass="content-description"/>

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>
</VBox>
